# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略，禁止提交。
# 真实模式读取这三个变量；--offline 模式不需要任何密钥。
# base_url 口径：含 /v1 的 OpenAI 兼容根（不带 /v1 时客户端会自动补 /v1），见 README。
LLM_API_KEY=sk-REPLACE_WITH_YOUR_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# 可选：显式代理（客户端 trust_env=False，不读系统代理）；留空则直连。
LLM_PROXY=
